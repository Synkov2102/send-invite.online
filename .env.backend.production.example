# Copy this file to .env.backend.production next to docker-compose.prod.yml on the VPS.
# Do not commit .env.backend.production.

FRONTEND_ORIGIN=https://send-invite.online
JSON_BODY_LIMIT=30mb

MONGODB_URI=
MONGODB_DB=invite

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://send-invite.online/api/auth/yandex/callback

# Robokassa. ResultURL: https://send-invite.online/api/payments/robokassa/result
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_TEST_MODE=true
ROBOKASSA_HASH_ALGORITHM=md5
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_FORCE_PATH_STYLE=false
