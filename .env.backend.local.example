# Copy this file to .env.backend.local next to docker-compose.local.yml.
# Do not commit .env.backend.local.

FRONTEND_ORIGIN=http://localhost:8080
JSON_BODY_LIMIT=30mb

MONGODB_URI=

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Robokassa. ResultURL: http://localhost:8080/api/payments/robokassa/result
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_TEST_MODE=true
ROBOKASSA_HASH_ALGORITHM=md5
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
